N_rec                   =     100               # Time-step interval for writing to 000.dat
N_rec_rho               =     300               # Time-step interval for writing to OUT folder | 300 is standard for N_step=100,000
N_step                  =  100000               # Time step size = 5*2*pi / N_step | Adjust N_rec_rho accordingly if N_step is changed
hx                      =   2e-02               # Grid spacing in x-direction | If hx,hy are changed, consider adjusting rec in rho(),pot() in write.cu
hy                      =   2e-02               # Grid spacing in y-direction | (see above)
Lx                      =      16               # Computational domain -Lx <= x <= Lx
Ly                      =      16               # Computational domain -Ly <= y <= Ly
omg                     =    1.01               # SOR over-relaxation factor
v0x                     = 0                     # Initial velocity in x-direction (corrected to represent actual velocity)
v0y                     = 1                     # Initial velocity in y-direction (y-canonical momentum)
Bz                      = 1                     # Magnetic flux density in z-direction
m                       = 1                     # Particle mass
q                       = 1                     # Particle charge
x0                      = -1                    # Initial x-position of classical particle
y0                      = 0                     # Initial y-position of classical particle
vSIZE                   =  1300e6               # Video memory size in bytes (700e6 on GTX-285, 1300e6 on GTX-480)
v0_                     =      10               # Reference velocity for normalization [m/s]
Bz_                     =      10               # Reference magnetic flux density for normalization [T]
mp_                     =  1.67262192e-27       # Reference mass for normalization [kg] (proton mass)
e_                      =  1.60217663e-19       # Reference charge for normalization [C] (elementary charge)
h_bar_                  = 1.05457182e-34        # Reduced Planck constant (Dirac constant) [J*s]
